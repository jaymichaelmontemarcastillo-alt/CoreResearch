PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Required for Phase 1 Migration)
MONGODB_URI=mongodb://localhost:27017/coreresearch
FIREBASE_PROJECT_ID=coreresearch-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@coreresearch-dev.iam.gserviceaccount.com
# Base64 encoded or JSON string of private key, or path to serviceAccountKey.json
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional Supabase Storage Configuration (Production Persistent Object Storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=documents

# NLP Adviser Matching Service (Phase 6)
# MATCHING_PROVIDER controls which matching provider is used:
#   'nlp'  — Production: calls Python FastAPI NLP service (default)
#   'mock' — Development: returns deterministic fake scores
MATCHING_PROVIDER=nlp
NLP_SERVICE_URL=http://localhost:8000
# Timeout for NLP service requests in milliseconds
NLP_TIMEOUT_MS=30000
