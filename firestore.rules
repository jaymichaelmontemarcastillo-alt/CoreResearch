rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('status', 'pending') in ['active', 'approved']
        && profile().get('is_approved', false) == true;
    }

    function staff() {
      return approved() && profile().get('role', '') in ['admin', 'research_coordinator'];
    }

    function groupMember(groupId) {
      return approved()
        && groupId is string
        && groupId != ''
        && exists(/databases/$(database)/documents/research_groups/$(groupId))
        && (
          request.auth.uid in get(/databases/$(database)/documents/research_groups/$(groupId)).data.get('memberIds', [])
          || get(/databases/$(database)/documents/research_groups/$(groupId)).data.get('leaderUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/research_groups/$(groupId)).data.get('studentId', '') == request.auth.uid
        );
    }

    function groupLeader(groupId) {
      return groupMember(groupId)
        && (
          get(/databases/$(database)/documents/research_groups/$(groupId)).data.get('leaderUid', '') == request.auth.uid
          || (
            get(/databases/$(database)/documents/research_groups/$(groupId)).data.get('memberIds', []).size() > 0
            && get(/databases/$(database)/documents/research_groups/$(groupId)).data.get('memberIds', [])[0] == request.auth.uid
          )
        );
    }

    function participant(data) {
      return approved() && (
        data.get('ownerId', '') == request.auth.uid
        || data.get('ownerUid', '') == request.auth.uid
        || data.get('studentId', '') == request.auth.uid
        || data.get('submittedByUid', '') == request.auth.uid
        || data.get('authorUid', '') == request.auth.uid
        || data.get('authorId', '') == request.auth.uid
        || data.get('adviserId', '') == request.auth.uid
        || data.get('adviser', '') == request.auth.uid
        || data.get('reviewerId', '') == request.auth.uid
        || request.auth.uid in data.get('memberIds', [])
        || request.auth.uid in data.get('authors', [])
        || request.auth.uid in data.get('panelistIds', [])
        || request.auth.uid in data.get('panelists', [])
        || groupMember(data.get('groupId', ''))
      );
    }

    function workspaceHasStudent(workspaceId, studentId) {
      return workspaceId is string
        && studentId is string
        && exists(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId))
        && (
          get(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId)).data.get('studentId', '') == studentId
          || studentId in get(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId)).data.get('memberIds', [])
        );
    }

    function adviserAssignedToWorkspace(workspaceId) {
      return workspaceId is string
        && exists(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId)).data.get('adviserId', '') == request.auth.uid;
    }

    function workspaceParticipant(workspaceId) {
      return approved()
        && workspaceId is string
        && exists(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId))
        && participant(get(/databases/$(database)/documents/manuscript_workspaces/$(workspaceId)).data);
    }

    function projectParticipant(projectId) {
      return groupMember(projectId)
        || (
          approved()
          && projectId is string
          && exists(/databases/$(database)/documents/research_projects/$(projectId))
          && participant(get(/databases/$(database)/documents/research_projects/$(projectId)).data)
        );
    }

    function assignedPanelist(defenseId) {
      return approved()
        && defenseId is string
        && exists(/databases/$(database)/documents/defense_schedules/$(defenseId))
        && request.auth.uid in get(/databases/$(database)/documents/defense_schedules/$(defenseId)).data.get('panelistIds', []);
    }

    function approvedAdviser(adviserId) {
      return adviserId is string
        && adviserId != ''
        && exists(/databases/$(database)/documents/users/$(adviserId))
        && get(/databases/$(database)/documents/users/$(adviserId)).data.get('role', '') == 'adviser'
        && get(/databases/$(database)/documents/users/$(adviserId)).data.get('status', 'pending') in ['active', 'approved']
        && get(/databases/$(database)/documents/users/$(adviserId)).data.get('is_approved', false) == true;
    }

    function acceptedGroupInvitation(groupId) {
      return request.resource.data.get('lastAcceptedInvitationId', '') is string
        && request.resource.data.get('lastAcceptedInvitationId', '') != ''
        && exists(/databases/$(database)/documents/group_invitations/$(request.resource.data.lastAcceptedInvitationId))
        && get(/databases/$(database)/documents/group_invitations/$(request.resource.data.lastAcceptedInvitationId)).data.get('groupId', '') == groupId
        && get(/databases/$(database)/documents/group_invitations/$(request.resource.data.lastAcceptedInvitationId)).data.get('inviteeId', '') == request.auth.uid
        && get(/databases/$(database)/documents/group_invitations/$(request.resource.data.lastAcceptedInvitationId)).data.get('status', '') == 'pending';
    }

    function acceptedAdviserRequest(groupId) {
      return request.resource.data.get('lastAcceptedAdviserRequestId', '') is string
        && request.resource.data.get('lastAcceptedAdviserRequestId', '') != ''
        && exists(/databases/$(database)/documents/adviser_requests/$(request.resource.data.lastAcceptedAdviserRequestId))
        && get(/databases/$(database)/documents/adviser_requests/$(request.resource.data.lastAcceptedAdviserRequestId)).data.get('groupId', '') == groupId
        && get(/databases/$(database)/documents/adviser_requests/$(request.resource.data.lastAcceptedAdviserRequestId)).data.get('adviserId', '') == request.auth.uid
        && get(/databases/$(database)/documents/adviser_requests/$(request.resource.data.lastAcceptedAdviserRequestId)).data.get('status', '') == 'accepted';
    }

    function canAccessEvaluation(data) {
      return staff()
        || (approved() && data.get('panelistId', '') == request.auth.uid)
        || assignedPanelist(data.get('defenseId', ''))
        || workspaceParticipant(data.get('workspaceId', ''))
        || projectParticipant(data.get('projectId', ''));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || approved());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'student') in ['student', 'adviser', 'panelist']
        && request.resource.data.get('role_id', request.resource.data.get('role', 'student'))
          == request.resource.data.get('role', 'student')
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.get('is_approved', false) == false;
      allow update: if signedIn() && (
        staff()
        || (
          request.auth.uid == userId
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('role_id', '') == resource.data.get('role_id', '')
          && request.resource.data.get('status', '') == resource.data.get('status', '')
          && request.resource.data.get('is_approved', false) == resource.data.get('is_approved', false)
        )
      );
      allow delete: if staff();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if staff();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if staff();
    }

    match /research_groups/{groupId} {
      allow read: if staff() || participant(resource.data);
      allow create: if staff()
        || (
          approved()
          && request.resource.data.get('memberIds', []).size() == 1
          && request.resource.data.get('memberIds', [])[0] == request.auth.uid
        );
      allow update: if staff() || (
        approved()
        && (
          request.auth.uid in resource.data.get('memberIds', [])
          || resource.data.get('adviserId', '') == request.auth.uid
          || request.resource.data.get('adviserId', '') == request.auth.uid
          || (
            request.auth.uid in request.resource.data.get('memberIds', [])
            && request.resource.data.get('lastAcceptedInvitationId', '') is string
          )
        )
        && (
          (
            groupLeader(groupId)
            && request.resource.data.get('leaderUid', '') == resource.data.get('leaderUid', '')
            && request.resource.data.get('memberIds', []) == resource.data.get('memberIds', [])
            && request.resource.data.get('members', []) == resource.data.get('members', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updatedAt', 'name', 'title', 'courseId', 'courseName',
              'sectionId', 'sectionName'
            ])
          ) || (
            !(request.auth.uid in resource.data.get('memberIds', []))
            && request.auth.uid in request.resource.data.get('memberIds', [])
            && request.resource.data.get('memberIds', []).size() == resource.data.get('memberIds', []).size() + 1
            && request.resource.data.get('memberIds', []).hasAll(resource.data.get('memberIds', []))
            && request.resource.data.get('memberIds', []).size() <= 3
            && request.resource.data.get('members', []).size() == request.resource.data.get('memberIds', []).size()
            && request.resource.data.get('status', '') == (request.resource.data.get('memberIds', []).size() >= 3 ? 'ready' : 'incomplete')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'memberIds', 'members', 'status', 'updatedAt', 'lastAcceptedInvitationId'
            ])
            && acceptedGroupInvitation(groupId)
          ) || (
            request.auth.uid in resource.data.get('memberIds', [])
            && !(request.auth.uid in request.resource.data.get('memberIds', []))
            && request.resource.data.get('memberIds', []).size() == resource.data.get('memberIds', []).size() - 1
            && request.resource.data.get('members', []).size() == request.resource.data.get('memberIds', []).size()
            && request.resource.data.get('status', '') == (request.resource.data.get('memberIds', []).size() >= 3 ? 'ready' : 'incomplete')
            && resource.data.get('memberIds', []).hasAll(request.resource.data.get('memberIds', []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'memberIds', 'members', 'status', 'updatedAt'
            ])
          ) || (
            resource.data.get('adviserId', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isArchived', 'status', 'archivedAt', 'archivedBy', 'archivedByName',
              'archiveReason', 'updatedAt'
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archivedBy'])
              || request.resource.data.get('archivedBy', '') == request.auth.uid
            )
          ) || (
            request.resource.data.get('adviserId', '') == request.auth.uid
            && acceptedAdviserRequest(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'adviserId', 'adviserName', 'updatedAt', 'lastAcceptedAdviserRequestId'
            ])
          )
        )
      );
      allow delete: if staff()
        || (
          approved()
          && resource.data.get('memberIds', []).size() == 1
          && request.auth.uid in resource.data.get('memberIds', [])
        );
    }

    match /group_invitations/{invitationId} {
      allow read: if staff()
        || (
          approved()
          && (
            resource.data.get('inviterId', '') == request.auth.uid
            || resource.data.get('inviteeId', '') == request.auth.uid
            || groupMember(resource.data.get('groupId', ''))
          )
        );
      allow create: if groupMember(request.resource.data.get('groupId', ''))
        && request.resource.data.get('inviterId', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('inviteeId', '') is string
        && get(/databases/$(database)/documents/research_groups/$(request.resource.data.get('groupId', ''))).data.get('memberIds', []).size() < 3
        && !(request.resource.data.get('inviteeId', '') in get(/databases/$(database)/documents/research_groups/$(request.resource.data.get('groupId', ''))).data.get('memberIds', []))
        && get(/databases/$(database)/documents/research_groups/$(request.resource.data.get('groupId', ''))).data.get('leaderUid', '') != request.resource.data.get('inviteeId', '')
        && get(/databases/$(database)/documents/research_groups/$(request.resource.data.get('groupId', ''))).data.get('studentId', '') != request.resource.data.get('inviteeId', '')
        && exists(/databases/$(database)/documents/users/$(request.resource.data.inviteeId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.inviteeId)).data.get('role', '') == 'student'
        && get(/databases/$(database)/documents/users/$(request.resource.data.inviteeId)).data.get('status', 'pending') in ['active', 'approved']
        && get(/databases/$(database)/documents/users/$(request.resource.data.inviteeId)).data.get('is_approved', false) == true;
      allow update: if staff()
        || (
          approved()
          && resource.data.get('inviteeId', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.get('status', '') in ['accepted', 'declined']
        )
        || (
          groupMember(resource.data.get('groupId', ''))
          && resource.data.get('inviterId', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.get('status', '') == 'cancelled'
        );
      allow delete: if staff();
    }

    match /research_projects/{projectId} {
      allow read: if staff() || participant(resource.data);
      allow create: if staff() || (
        participant(request.resource.data)
        && (
          request.resource.data.get('groupId', '') == ''
          || groupMember(request.resource.data.get('groupId', ''))
        )
      );
      allow update: if staff() || (
        participant(resource.data)
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
        && request.resource.data.get('adviserId', '') == resource.data.get('adviserId', '')
        && (
          request.resource.data.get('memberIds', []) == resource.data.get('memberIds', [])
          || groupLeader(resource.data.get('groupId', ''))
        )
      );
      allow delete: if staff();
    }

    match /proposals/{proposalId} {
      allow read: if staff() || participant(resource.data);
      allow create: if staff() || (
        participant(request.resource.data)
        && (
          request.resource.data.get('groupId', '') == ''
          || groupMember(request.resource.data.get('groupId', ''))
        )
      );
      allow update: if staff() || (
        participant(resource.data)
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        && request.resource.data.get('submittedByUid', '') == resource.data.get('submittedByUid', '')
        && (
          request.resource.data.get('memberIds', []) == resource.data.get('memberIds', [])
          || groupLeader(resource.data.get('groupId', ''))
        )
      );
      allow delete: if staff() || resource.data.get('submittedByUid', '') == request.auth.uid;
    }

    match /manuscript_workspaces/{workspaceId} {
      allow read: if staff() || participant(resource.data);
      allow create: if staff() || (
        participant(request.resource.data)
        && (
          request.resource.data.get('groupId', '') == ''
          || groupMember(request.resource.data.get('groupId', ''))
        )
      );
      allow update: if staff() || (
        participant(resource.data)
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
        && request.resource.data.get('adviserId', '') == resource.data.get('adviserId', '')
        && (
          request.resource.data.get('memberIds', []) == resource.data.get('memberIds', [])
          || groupLeader(resource.data.get('groupId', ''))
        )
      );
      allow delete: if staff();
    }

    match /documents/{documentId} {
      allow read: if staff() || participant(resource.data);
      allow create: if approved() && (
        request.resource.data.get('ownerId', '') == request.auth.uid
          && (
            request.resource.data.get('groupId', '') == ''
            || groupMember(request.resource.data.get('groupId', ''))
          )
        || (participant(request.resource.data)
          && (
            request.resource.data.get('groupId', '') == ''
            || groupMember(request.resource.data.get('groupId', ''))
          ))
      );
      allow update: if staff() || (
        participant(resource.data)
        && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
        && (
          request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
          || groupMember(request.resource.data.get('groupId', ''))
        )
      );
      allow delete: if staff() || resource.data.get('ownerId', '') == request.auth.uid;
    }

    match /manuscript_drafts/{projectId} {
      allow read: if staff() || participant(resource.data) || groupMember(projectId);
      allow create: if staff() || participant(request.resource.data) || groupMember(projectId);
      allow update: if staff() || (
        (participant(resource.data) || groupMember(projectId))
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        && request.resource.data.get('lastSavedBy', request.auth.uid) == request.auth.uid
      );
      allow delete: if staff();

      match /comments/{commentId} {
        allow read: if staff()
          || participant(get(/databases/$(database)/documents/manuscript_drafts/$(projectId)).data)
          || groupMember(projectId);
        allow create: if approved()
          && (
            staff()
            || participant(get(/databases/$(database)/documents/manuscript_drafts/$(projectId)).data)
            || groupMember(projectId)
          )
          && request.resource.data.get('authorId', request.auth.uid) == request.auth.uid;
        allow update: if staff()
          || (
            participant(get(/databases/$(database)/documents/manuscript_drafts/$(projectId)).data)
            && resource.data.get('authorId', '') == request.auth.uid
            && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
            && request.resource.data.get('projectId', '') == resource.data.get('projectId', '')
          );
        allow delete: if staff();
      }
    }

    match /manuscript_versions/{versionId} {
      allow read: if staff() || participant(resource.data);
      allow create: if staff() || participant(request.resource.data);
      allow update: if staff() || (
        participant(resource.data)
        && request.resource.data.get('projectId', '') == resource.data.get('projectId', '')
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        && request.resource.data.get('submittedByUid', '') == resource.data.get('submittedByUid', '')
      );
      allow delete: if staff();
    }

    match /research_tasks/{taskId} {
      allow read: if staff() || participant(resource.data);
      allow create: if staff()
        || (
          approved()
          && request.resource.data.get('adviserId', '') == request.auth.uid
          && adviserAssignedToWorkspace(request.resource.data.get('workspaceId', ''))
          && workspaceHasStudent(
            request.resource.data.get('workspaceId', ''),
            request.resource.data.get('studentId', '')
          )
        );
      allow update: if staff()
        || (
          approved()
          && resource.data.get('adviserId', '') == request.auth.uid
          && request.resource.data.get('adviserId', '') == resource.data.get('adviserId', '')
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && request.resource.data.get('workspaceId', '') == resource.data.get('workspaceId', '')
        )
        || (
          approved()
          && resource.data.get('studentId', '') == request.auth.uid
          && request.resource.data.get('status', '') in ['in_progress', 'submitted']
          && request.resource.data.get('adviserId', '') == resource.data.get('adviserId', '')
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && request.resource.data.get('workspaceId', '') == resource.data.get('workspaceId', '')
        );
      allow delete: if staff() || (approved() && resource.data.get('adviserId', '') == request.auth.uid);
    }

    match /research_feedback/{feedbackId} {
      allow read: if staff() || participant(resource.data) || workspaceParticipant(resource.data.get('workspaceId', ''));
      allow create: if staff() || (
        approved()
        && request.resource.data.get('authorId', '') == request.auth.uid
        && request.resource.data.get('authorRole', '') == profile().get('role', '')
        && workspaceParticipant(request.resource.data.get('workspaceId', ''))
      );
      allow update: if staff()
        || (
          approved()
          && resource.data.get('authorId', '') == request.auth.uid
          && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
          && request.resource.data.get('workspaceId', '') == resource.data.get('workspaceId', '')
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
        )
        || (
          workspaceParticipant(resource.data.get('workspaceId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.get('status', '') in ['open', 'addressed', 'resolved']
        )
        || (
          approved()
          && resource.data.get('adviserId', '') == request.auth.uid
          && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
          && request.resource.data.get('workspaceId', '') == resource.data.get('workspaceId', '')
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
        );
      allow delete: if staff();
    }

    match /adviser_requests/{requestId} {
      allow read: if staff()
        || (
          approved()
          && (
            resource.data.get('studentId', '') == request.auth.uid
            || resource.data.get('adviserId', '') == request.auth.uid
            || groupMember(resource.data.get('groupId', ''))
          )
        );
      allow create: if approved()
        && request.resource.data.get('studentId', '') == request.auth.uid
        && approvedAdviser(request.resource.data.get('adviserId', ''))
        && request.resource.data.get('status', 'pending') == 'pending'
        && (
          request.resource.data.get('groupId', '') == ''
          || groupMember(request.resource.data.get('groupId', ''))
        );
      allow update: if staff()
        || (
          approved()
          && resource.data.get('adviserId', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && request.resource.data.get('adviserId', '') == resource.data.get('adviserId', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.get('status', '') in ['accepted', 'declined']
        )
        || (
          approved()
          && (
            resource.data.get('studentId', '') == request.auth.uid
            || groupMember(resource.data.get('groupId', ''))
            || groupLeader(resource.data.get('groupId', ''))
          )
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && request.resource.data.get('adviserId', '') == resource.data.get('adviserId', '')
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId', 'updatedAt', 'isArchived'])
            || (
              groupLeader(resource.data.get('groupId', ''))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
            )
          )
          && (
            request.resource.data.get('groupId', '') == ''
            || groupMember(request.resource.data.get('groupId', ''))
          )
        );
      allow delete: if staff() || (approved() && resource.data.get('studentId', '') == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if staff()
        || (
          approved()
          && (
            resource.data.get('userId', '') == request.auth.uid
            || resource.data.get('createdByUid', '') == request.auth.uid
          )
        );
      allow create: if approved()
        && request.resource.data.get('createdByUid', '') == request.auth.uid
        && request.resource.data.get('userId', '') is string
        && request.resource.data.get('userId', '') != '';
      allow update: if staff()
        || (
          approved()
          && resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        )
        || (
          approved()
          && resource.data.get('createdByUid', '') == request.auth.uid
          && request.resource.data.get('createdByUid', '') == request.auth.uid
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id', 'title', 'message', 'type', 'read', 'link', 'linkUrl',
            'relatedStudentId', 'relatedId', 'invitationId', 'groupId',
            'metadata', 'createdAt'
          ])
        );
      allow delete: if staff() || (approved() && resource.data.get('userId', '') == request.auth.uid);
    }

    match /system_activities/{activityId} {
      allow read: if staff() || (approved() && resource.data.get('actorId', '') == request.auth.uid);
      allow create: if approved() && request.resource.data.get('actorId', '') == request.auth.uid;
      allow update, delete: if staff();
    }

    match /faculty_assignments/{assignmentId} {
      allow read: if staff()
        || (approved() && resource.data.get('adviserId', '') == request.auth.uid)
        || groupMember(resource.data.get('groupId', ''));
      allow write: if staff();
    }

    match /advisers/{adviserId} {
      allow read: if approved();
      allow write: if staff();
    }

    match /defense_schedules/{scheduleId} {
      allow read: if staff()
        || (
          approved()
          && (
            resource.data.get('adviserId', '') == request.auth.uid
            || request.auth.uid in resource.data.get('panelistIds', [])
            || projectParticipant(resource.data.get('projectId', ''))
          )
        );
      allow write: if staff();
    }

    match /evaluations/{evaluationId} {
      allow read: if canAccessEvaluation(resource.data);
      allow create: if assignedPanelist(request.resource.data.get('defenseId', ''))
        && request.resource.data.get('panelistId', '') == request.auth.uid;
      allow update: if assignedPanelist(resource.data.get('defenseId', ''))
        && resource.data.get('panelistId', '') == request.auth.uid
        && request.resource.data.get('panelistId', '') == resource.data.get('panelistId', '')
        && request.resource.data.get('defenseId', '') == resource.data.get('defenseId', '')
        && request.resource.data.get('projectId', '') == resource.data.get('projectId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scores', 'totalScore', 'remarks', 'submittedAt'
        ]);
      allow delete: if staff();
    }

    match /proposal_evaluations/{evaluationId} {
      allow read: if canAccessEvaluation(resource.data);
      allow create: if assignedPanelist(request.resource.data.get('defenseId', ''))
        && request.resource.data.get('panelistId', '') == request.auth.uid;
      allow update: if assignedPanelist(resource.data.get('defenseId', ''))
        && resource.data.get('panelistId', '') == request.auth.uid
        && request.resource.data.get('panelistId', '') == resource.data.get('panelistId', '')
        && request.resource.data.get('defenseId', '') == resource.data.get('defenseId', '')
        && request.resource.data.get('workspaceId', '') == resource.data.get('workspaceId', '')
        && request.resource.data.get('projectId', '') == resource.data.get('projectId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scores', 'subTotals', 'verdict', 'submittedAt'
        ]);

      allow delete: if staff();
    }

    match /final_evaluations/{evaluationId} {
      allow read: if canAccessEvaluation(resource.data);
      allow create: if assignedPanelist(request.resource.data.get('defenseId', ''))
        && request.resource.data.get('panelistId', '') == request.auth.uid;
      allow update: if assignedPanelist(resource.data.get('defenseId', ''))
        && resource.data.get('panelistId', '') == request.auth.uid
        && request.resource.data.get('panelistId', '') == resource.data.get('panelistId', '')
        && request.resource.data.get('defenseId', '') == resource.data.get('defenseId', '')
        && request.resource.data.get('workspaceId', '') == resource.data.get('workspaceId', '')
        && request.resource.data.get('projectId', '') == resource.data.get('projectId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scores', 'subTotals', 'verdict', 'submittedAt'
        ]);
      allow delete: if staff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
