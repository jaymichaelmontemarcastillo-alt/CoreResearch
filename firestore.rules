rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection:
    // Authenticated users can read profiles (needed for directory, adviser matching, committee management, etc.)
    // Users can write/update their own profile
    // Authenticated users can create their user profile during registration
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Academic lookup collections:
    // Available to unauthenticated visitors so the registration page can load courses and sections
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule for all other application data
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
