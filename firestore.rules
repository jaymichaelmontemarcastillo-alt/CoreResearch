rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'research_coordinator'];
    }

    function isResearchGroupMember(groupId) {
      return isSignedIn() &&
        groupId != null &&
        groupId != '' &&
        exists(/databases/$(database)/documents/research_groups/$(groupId)) &&
        (
          request.auth.uid in get(/databases/$(database)/documents/research_groups/$(groupId)).data.memberIds ||
          get(/databases/$(database)/documents/research_groups/$(groupId)).data.leaderId == request.auth.uid ||
          get(/databases/$(database)/documents/research_groups/$(groupId)).data.adviserId == request.auth.uid
        );
    }

    function canMutateDocument(data) {
      return isSignedIn() &&
        (
          request.auth.uid == data.ownerId ||
          request.auth.uid in (data.authors || []) ||
          request.auth.uid in (data.memberIds || []) ||
          request.auth.uid == data.adviser ||
          request.auth.uid in (data.panelists || []) ||
          isResearchGroupMember(data.groupId) ||
          isStaff()
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow delete: if isStaff();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /research_groups/{groupId} {
      allow create: if isSignedIn() &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds;
      allow read: if isStaff() || isResearchGroupMember(groupId);
      allow update: if isStaff() ||
        (isSignedIn() && (
          request.auth.uid == resource.data.leaderId ||
          request.auth.uid in resource.data.memberIds ||
          request.auth.uid == resource.data.adviserId
        ));
      allow delete: if isStaff();
    }

    match /adviser_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.adviserId == request.auth.uid ||
        isResearchGroupMember(resource.data.groupId) ||
        isStaff()
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        isStaff() ||
        (resource.data.adviserId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['accepted', 'declined']) ||
        (resource.data.studentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived', 'updatedAt']) &&
          request.resource.data.isArchived is bool) ||
        ((resource.data.studentId == request.auth.uid || isResearchGroupMember(resource.data.groupId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId', 'updatedAt']) &&
          (resource.data.groupId == request.resource.data.groupId ||
            (resource.data.groupId == '' && isResearchGroupMember(request.resource.data.groupId))))
      );
      allow delete: if isSignedIn() && (
        isStaff() ||
        ((resource.data.studentId == request.auth.uid || isResearchGroupMember(resource.data.groupId)) &&
          resource.data.status == 'pending')
      );
    }

    match /proposals/{proposalId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.submittedByUid ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.submittedByUid == request.auth.uid ||
        request.auth.uid in (request.resource.data.memberIds || [])
      );
      allow update: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.submittedByUid ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow delete: if isStaff();
    }

    match /manuscript_workspaces/{workspaceId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.adviserId ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        request.auth.uid in (request.resource.data.memberIds || []) ||
        request.auth.uid == request.resource.data.adviserId ||
        isResearchGroupMember(request.resource.data.groupId)
      );
      allow update: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.adviserId ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow delete: if isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    match /group_invitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource.data.inviterId == request.auth.uid ||
        resource.data.inviteeId == request.auth.uid ||
        isResearchGroupMember(resource.data.groupId) ||
        isStaff()
      );
      allow create: if isSignedIn() && (
        request.resource.data.inviterId == request.auth.uid ||
        request.resource.data.inviteeId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.inviterId == request.auth.uid ||
        resource.data.inviteeId == request.auth.uid ||
        isStaff()
      );
      allow delete: if isStaff();
    }

    match /documents/{documentId} {
      allow read: if isSignedIn() && canMutateDocument(resource.data);
      allow create: if isSignedIn() && canMutateDocument(request.resource.data);
      allow update: if isSignedIn() && canMutateDocument(resource.data);
      allow delete: if isStaff();
    }

    match /proposal_evaluations/{evaluationId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.studentUid ||
        request.auth.uid == resource.data.adviserId ||
        request.auth.uid in (resource.data.panelistIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && (
        isStaff() ||
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.adviserId == request.auth.uid ||
        request.auth.uid in (request.resource.data.panelistIds || [])
      );
      allow update: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.studentUid ||
        request.auth.uid == resource.data.adviserId ||
        request.auth.uid in (resource.data.panelistIds || [])
      );
      allow delete: if isStaff();
    }

    match /final_evaluations/{evaluationId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.studentUid ||
        request.auth.uid == resource.data.adviserId ||
        request.auth.uid in (resource.data.panelistIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && (
        isStaff() ||
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.adviserId == request.auth.uid ||
        request.auth.uid in (request.resource.data.panelistIds || [])
      );
      allow update: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.studentUid ||
        request.auth.uid == resource.data.adviserId ||
        request.auth.uid in (resource.data.panelistIds || [])
      );
      allow delete: if isStaff();
    }

    match /research_tasks/{taskId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid in (resource.data.assigneeIds || []) ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.auth.uid in (request.resource.data.assigneeIds || []) ||
        isResearchGroupMember(request.resource.data.groupId)
      );
      allow update: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid in (resource.data.assigneeIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow delete: if isStaff();
    }

    match /research_feedback/{feedbackId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.auth.uid in (request.resource.data.memberIds || []) ||
        isResearchGroupMember(request.resource.data.groupId)
      );
      allow update: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid in (resource.data.memberIds || []) ||
        isResearchGroupMember(resource.data.groupId)
      );
      allow delete: if isStaff();
    }

    match /system_activities/{activityId} {
      allow read: if isSignedIn() && (isStaff() || request.auth.uid == resource.data.userId || request.auth.uid == resource.data.actorUid);
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn() && (isStaff() || request.auth.uid == resource.data.actorUid);
      allow delete: if isStaff();
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
